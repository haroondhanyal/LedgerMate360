DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ledgermate?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
WEB_URL="http://localhost:3000"
PORT=4000

# Optional: enables the cloud multimodal AI assistant. Keep secrets server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Increase for local automation; production defaults to 180 requests/minute.
RATE_LIMIT_MAX=2000

# Performance profiles. Increase the scale values for load or stress runs.
PERF_USER_SCALE=1
PERF_ITERATION_SCALE=1
PERF_P95_MS=1500
PERF_ERROR_RATE=0.01
K6_VUS=5
K6_ITERATIONS=20
